      "title": "6. Deep Diagnostics",
      "type": "row"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: oba_unmatched_stop_cluster_count\nQuestion answered: \"Where are failures concentrated?\"",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "id": 601,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "name": "Prometheus"
          },
          "expr": "sum by (agency_name, server_url, station_id, cluster_id, cluster_lat, cluster_lon) (oba_unmatched_stop_cluster_count{server_url=~\"$server_url\"})",
