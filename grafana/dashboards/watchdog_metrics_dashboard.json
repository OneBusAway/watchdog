      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "1. System Availability",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "description": "Metrics: oba_api_status\nQuestion answered: \"Is the API up?\"",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "fillOpacity": 70,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 1,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "alignValue": "center",
        "annotations": {
          "clustering": -1,
          "multiLane": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "auto",
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "editorMode": "code",
          "expr": "oba_api_status{server_url=~\"$server_url\"}",
          "legendFormat": "{{agency_name}} ({{agency_id}}) \u00b7 {{server_url}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "1.1 API Status",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: http_outgoing_request_duration_seconds\nQuestion answered: \"Are external dependencies becoming slow?\"\n\nVisualization: Heatmap\nRationale: Latency is best viewed as a distribution. A heatmap reveals not just average slowness, but specifically if a subset of requests (e.g. 99th percentile) are stalling out.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 102,
      "targets": [
        {
          "expr": "sum(rate(http_outgoing_request_duration_seconds_bucket{url=~\".*\"}[5m])) by (le)",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          },
          "format": "heatmap"
        }
      ],
      "title": "1.2 Dependency Latency",
      "type": "heatmap",
      "options": {
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 200,
      "panels": [],
      "title": "2. Static GTFS Health",
      "type": "row"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_bundle_days_until_earliest_expiration, gtfs_bundle_days_until_latest_expiration\nQuestion answered: \"Are GTFS bundles approaching expiration?\"\n\nVisualization: Bar Gauge\nRationale: This metric is a countdown. Rendering it as a horizontal bar gauge allows operators to stack multiple feeds side-by-side. The bars act as a visual timer that shifts from green to warning red as the days until expiration drop below the critical threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 201,
      "targets": [
        {
          "expr": "(gtfs_bundle_days_until_earliest_expiration{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}) * 86400",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "(gtfs_bundle_days_until_latest_expiration{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}) * 86400",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "2.1 Feed Expiration",
      "type": "bargauge",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          }
        }
      }
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_static_feed_fetch_success, gtfs_static_feed_failure_since_timestamp_seconds, gtfs_static_feed_conservative_mode, gtfs_static_feed_failure_info, gtfs_static_feed_agency_mapping_info, gtfs_static_feed_agency_mapping_failure\nQuestion answered: \"Which source feeds are healthy, retry-limited, and proven to map to which agencies?\"",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 202,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "gtfs_static_feed_agency_mapping_info{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_agency_mapping_failure{server_url=~\"$server_url\"}",
          "refId": "B",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_fetch_success{server_url=~\"$server_url\"}",
          "refId": "C",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "time() - gtfs_static_feed_failure_since_timestamp_seconds{server_url=~\"$server_url\"} > 0",
          "refId": "D",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_conservative_mode{server_url=~\"$server_url\"}",
          "refId": "E",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_failure_info{server_url=~\"$server_url\"} == 1",
          "refId": "F",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "2.2 Static Feed Health / Agency Mapping",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 300,
      "panels": [],
      "title": "3. Realtime Feed Health",
      "type": "row"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: realtime_vehicle_positions_count_gtfs_rt, oba_agency_active_vehicles_count, gtfs_rt_tracked_vehicles_count\nQuestion answered: \"Is realtime coverage dropping?\"\n\nVisualization: Time Series\nRationale: Vehicle volume naturally ebbs and flows with the daily transit schedule. Overlaying the GTFS-RT feed count directly against the API output count on a time series line chart allows operators to immediately spot ingestion drops or system divergence from the historical daily baseline.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 301,
      "targets": [
        {
          "expr": "realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_agency_active_vehicles_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_tracked_vehicles_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "C",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_schedule_available{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "legendFormat": "Schedule available {{agency_name}} ({{agency_id}})",
          "refId": "D",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_scheduled_service_active{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "legendFormat": "Scheduled service active {{agency_name}} ({{agency_id}})",
          "refId": "E",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "(((realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} == 0) and on (agency_id, agency_name, server_name, server_url) (gtfs_schedule_available == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_scheduled_service_active == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_static_bundle_usable == 1) and on (agency_id, server_name, server_url) (min by (agency_id, server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id!=\"\"}) == 1) and on (agency_id, server_name, server_url) ((time() - min by (agency_id, server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id!=\"\"})) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300)))) or ((realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} == 0) and on (agency_id, agency_name, server_name, server_url) (gtfs_schedule_available == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_scheduled_service_active == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_static_bundle_usable == 1) and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300))))) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300)))",
          "legendFormat": "Unexpected zero {{agency_name}} ({{agency_id}})",
          "refId": "F",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicles_count{server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300))) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300)))",
          "legendFormat": "Unattributed total {{server_name}}",
          "refId": "G",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicles_by_reason_count{server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300))) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300)))",
          "legendFormat": "Unattributed {{reason}}",
          "refId": "H",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicle_potential_agency_associations_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300))) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left (clamp_max(clamp_min(watchdog_collection_interval_seconds * 3, 60), 300)))",
          "legendFormat": "Possible owner {{agency_name}} (non-additive)",
          "refId": "I",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.1 Vehicle Volume",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_rt_feed_source_timestamp_seconds, gtfs_rt_feed_payload_last_changed_timestamp_seconds\nQuestion answered: \"How stale is realtime data?\"\n\nVisualization: Bar Gauge\nRationale: Freshness requires an immediate live status check. A vertical bar gauge per agency immediately catches the eye. As realtime updates lag, the bars fill up and hit red thresholds, quickly highlighting exactly which agency's data pipeline is hung.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 302,
      "targets": [
        {
          "expr": "(time() - gtfs_rt_feed_source_timestamp_seconds{server_url=~\"$server_url\"}) and on (agency_id, agency_name, server_name, server_url, feed, feed_url) (gtfs_rt_feed_fetch_success{server_url=~\"$server_url\"} == 1)",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "(time() - gtfs_rt_feed_payload_last_changed_timestamp_seconds{server_url=~\"$server_url\"}) and on (agency_id, agency_name, server_name, server_url, feed, feed_url) (gtfs_rt_feed_fetch_success{server_url=~\"$server_url\"} == 1)",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.2 Feed Freshness",
      "type": "bargauge",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        }
      }
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_rt_vehicle_source_timestamp_advances_total, gtfs_rt_vehicle_state_changes_total\nQuestion answered: \"Are realtime updates continuously flowing?\"\n\nVisualization: Time Series (with rate)\nRationale: Because this metric is a continuously accumulating counter, visualizing the raw number is unhelpful. Applying a Prometheus rate() function and plotting it on a time-series chart is the only way to monitor the live flow rate and capture sudden velocity drops.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 303,
      "targets": [
        {
          "expr": "sum by (agency_id, server_url, feed) (rate(gtfs_rt_vehicle_source_timestamp_advances_total{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "sum by (agency_id, server_url, feed) (rate(gtfs_rt_vehicle_state_changes_total{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}[$__rate_interval]))",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.3 Update Throughput",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 400,
      "panels": [],
      "title": "4. Matching Quality",
      "type": "row"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: oba_realtime_records_count, oba_realtime_trips_matched_count, oba_realtime_trips_unmatched_count, oba_realtime_trip_match_ratio\nQuestion answered: \"How much realtime trip data is usable?\"\n\nVisualization: Time Series (Stacked Area)\nRationale: Stacking matched over unmatched trips as filled areas reveals total realtime volume while simultaneously indicating the match proportion. The unmatched area growing is an early warning of schedule drift. The match ratio is overlaid as a line on the right y-axis for precise reading.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "id": 401,
      "targets": [
        {
          "expr": "oba_realtime_records_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_realtime_trips_matched_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_realtime_trips_unmatched_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "C",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_realtime_trip_match_ratio{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "D",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "4.1 Trip Matching",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 50,
            "gradientMode": "opacity",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ratio.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      }
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: oba_stops_matched_count, oba_stops_unmatched_count, oba_stop_match_ratio\nQuestion answered: \"Are stop mappings degrading?\"\n\nVisualization: Bar Gauge\nRationale: A ranking bar gauge sorted by worst agencies first allows operators to immediately triage the most problematic feeds. The gradient color (green to red) makes it visually obvious which stops need attention.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "id": 402,
      "targets": [
        {
          "expr": "oba_stops_matched_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_stops_unmatched_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_stop_match_ratio{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "C",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "4.2 Stop Matching",
      "type": "bargauge",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: oba_scheduled_trips_count\nQuestion answered: \"What is the overall realtime coverage footprint?\"\n\nVisualization: Stat\nRationale: This panel conveys the headline numbers for a transit deployment: total scheduled trips. A stat panel with a large-font single-value callout provides instant situational awareness as an executive KPI.",
      "gridPos": {
