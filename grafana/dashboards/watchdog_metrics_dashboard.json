          }
        },
        {
          "expr": "gtfs_bundle_days_until_latest_expiration{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "2.1 Feed Expiration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_static_feed_fetch_success, gtfs_static_feed_failure_since_timestamp_seconds, gtfs_static_feed_conservative_mode, gtfs_static_feed_failure_info, gtfs_static_feed_agency_mapping_info, gtfs_static_feed_agency_mapping_failure\nQuestion answered: \"Which source feeds are healthy, retry-limited, and proven to map to which agencies?\"",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 202,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "gtfs_static_feed_agency_mapping_info{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_agency_mapping_failure{server_url=~\"$server_url\"}",
          "refId": "B",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_fetch_success{server_url=~\"$server_url\"}",
          "refId": "C",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "time() - gtfs_static_feed_failure_since_timestamp_seconds{server_url=~\"$server_url\"} > 0",
          "refId": "D",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_conservative_mode{server_url=~\"$server_url\"}",
          "refId": "E",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_static_feed_failure_info{server_url=~\"$server_url\"} == 1",
          "refId": "F",
          "format": "table",
          "instant": true,
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "2.2 Static Feed Health / Agency Mapping",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 300,
      "panels": [],
      "title": "3. Realtime Feed Health",
      "type": "row"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: realtime_vehicle_positions_count_gtfs_rt, oba_agency_active_vehicles_count, gtfs_rt_tracked_vehicles_count, gtfs_rt_unattributed_vehicles_count, gtfs_rt_unattributed_vehicles_by_reason_count, gtfs_rt_unattributed_vehicle_potential_agency_associations_count, gtfs_schedule_available, gtfs_scheduled_service_active\nQuestion answered: \"Is zero realtime coverage expected, and why were vehicles not assigned?\" Outside service is only schedule available=1 and active=0. Unexpected Zero uses the dynamic collection freshness window. Potential agency associations are possible owners, not assignments: one ambiguous vehicle may appear under multiple potential agencies, so do not sum them as a distinct vehicle total. No alert is installed by default.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 301,
      "targets": [
        {
          "expr": "realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "oba_agency_active_vehicles_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_tracked_vehicles_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "refId": "C",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_schedule_available{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "legendFormat": "Schedule available {{agency_name}} ({{agency_id}})",
          "refId": "D",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_scheduled_service_active{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}",
          "legendFormat": "Scheduled service active {{agency_name}} ({{agency_id}})",
          "refId": "E",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "(((realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} == 0) and on (agency_id, agency_name, server_name, server_url) (gtfs_schedule_available == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_scheduled_service_active == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_static_bundle_usable == 1) and on (agency_id, server_name, server_url) (min by (agency_id, server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id!=\"\"}) == 1) and on (agency_id, server_name, server_url) ((time() - min by (agency_id, server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id!=\"\"})) < on() group_left watchdog:collection_freshness_window_seconds)) or ((realtime_vehicle_positions_count_gtfs_rt{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} == 0) and on (agency_id, agency_name, server_name, server_url) (gtfs_schedule_available == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_scheduled_service_active == 1) and on (agency_id, agency_name, server_name, server_url) (gtfs_static_bundle_usable == 1) and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left watchdog:collection_freshness_window_seconds))) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left watchdog:collection_freshness_window_seconds)",
          "legendFormat": "Unexpected zero {{agency_name}} ({{agency_id}})",
          "refId": "F",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicles_count{server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left watchdog:collection_freshness_window_seconds) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left watchdog:collection_freshness_window_seconds)",
          "legendFormat": "Unattributed total {{server_name}}",
          "refId": "G",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicles_by_reason_count{server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left watchdog:collection_freshness_window_seconds) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left watchdog:collection_freshness_window_seconds)",
          "legendFormat": "Unattributed {{reason}}",
          "refId": "H",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "gtfs_rt_unattributed_vehicle_potential_agency_associations_count{agency_id=~\"$agency_id\",server_url=~\"$server_url\"} and on (server_name, server_url) (min by (server_name, server_url) (gtfs_rt_feed_fetch_success{agency_id=\"\"}) == 1) and on (server_name, server_url) ((time() - min by (server_name, server_url) (gtfs_rt_feed_last_successful_fetch_timestamp_seconds{agency_id=\"\"})) < on() group_left watchdog:collection_freshness_window_seconds) and on() ((time() - watchdog_collection_last_completed_timestamp_seconds) < on() group_left watchdog:collection_freshness_window_seconds)",
          "legendFormat": "Possible owner {{agency_name}} (non-additive)",
          "refId": "I",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.1 Vehicle Volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_rt_feed_source_timestamp_seconds, gtfs_rt_feed_payload_last_changed_timestamp_seconds\nQuestion answered: \"Is each successfully fetched source and payload fresh?\"",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 302,
      "targets": [
        {
          "expr": "(time() - gtfs_rt_feed_source_timestamp_seconds{server_url=~\"$server_url\"}) and on (agency_id, agency_name, server_name, server_url, feed, feed_url) (gtfs_rt_feed_fetch_success{server_url=~\"$server_url\"} == 1)",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "(time() - gtfs_rt_feed_payload_last_changed_timestamp_seconds{server_url=~\"$server_url\"}) and on (agency_id, agency_name, server_name, server_url, feed, feed_url) (gtfs_rt_feed_fetch_success{server_url=~\"$server_url\"} == 1)",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.2 Feed Freshness",
      "type": "timeseries"
    },
    {
      "datasource": {
        "name": "Prometheus"
      },
      "description": "Metrics: gtfs_rt_vehicle_source_timestamp_advances_total, gtfs_rt_vehicle_state_changes_total\nQuestion answered: \"Are source clocks and semantic vehicle states advancing?\"",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 303,
      "targets": [
        {
          "expr": "sum by (agency_id, server_url, feed) (rate(gtfs_rt_vehicle_source_timestamp_advances_total{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "name": "Prometheus"
          }
        },
        {
          "expr": "sum by (agency_id, server_url, feed) (rate(gtfs_rt_vehicle_state_changes_total{agency_id=~\"$agency_id\",server_url=~\"$server_url\"}[$__rate_interval]))",
          "refId": "B",
          "datasource": {
            "name": "Prometheus"
          }
        }
      ],
      "title": "3.3 Update Throughput",
      "type": "timeseries"
    },
